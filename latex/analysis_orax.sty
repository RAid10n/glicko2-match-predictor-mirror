%% ---------- Paquetes base ----------
\usepackage{titlesec}
\usepackage{fontspec}
\usepackage{xcolor}
\usepackage[left=3cm, right=2.5cm, top=2.7cm, bottom=2.5cm, headheight=14pt]{geometry}
\usepackage{fancyhdr}
\usepackage{setspace}
\usepackage{etoolbox}
\usepackage{booktabs}
\usepackage{array}

%% ============================================================
%%  TIPOGRAFÍA — Latin Modern Roman (aspecto clásico de tesis)
%% ============================================================

\setmainfont{Latin Modern Roman}[
  Ligatures = TeX,
  Numbers   = OldStyle
]
\setmonofont{Latin Modern Mono}[Scale=MatchLowercase]

% Tamaños clásicos de TEG (cuerpo ~11.5pt con interlineado cómodo)
\renewcommand{\normalsize}{\fontsize{11.5pt}{16pt}\selectfont}
\renewcommand{\small}{\fontsize{10.5pt}{14.5pt}\selectfont}
\renewcommand{\footnotesize}{\fontsize{9.5pt}{12.5pt}\selectfont}
\renewcommand{\large}{\fontsize{13pt}{17pt}\selectfont}
\renewcommand{\Large}{\fontsize{15.5pt}{20pt}\selectfont}
\renewcommand{\LARGE}{\fontsize{18.5pt}{23pt}\selectfont}
\renewcommand{\huge}{\fontsize{23pt}{28pt}\selectfont}
\renewcommand{\Huge}{\fontsize{30pt}{34pt}\selectfont}

\linespread{1.08}

%% ============================================================
%%  PALETA MONOCROMA — escala de grises
%% ============================================================

\definecolor{InkBlack}{gray}{0.12}        % texto principal, títulos
\definecolor{DarkGray}{gray}{0.28}        % subtítulos, énfasis
\definecolor{MediumGray}{gray}{0.50}      % texto secundario, headers
\definecolor{SoftGray}{gray}{0.70}        % filetes decorativos
\definecolor{LightGray}{gray}{0.92}       % fondos suaves

%% ============================================================
%%  Nombres en español
%% ============================================================
\renewcommand{\chaptername}{Cap\'itulo}
\renewcommand{\contentsname}{\'Indice general}
\renewcommand{\bibname}{Bibliograf\'ia}
\renewcommand{\listfigurename}{\'Indice de figuras}
\renewcommand{\listtablename}{\'Indice de tablas}

%% ============================================================
%%  FORMATO DE CAPÍTULO — número grande gris a la derecha,
%%  "CAPÍTULO" abajo, línea horizontal y título en negrita.
%% ============================================================

\makeatletter

% --- Capítulos numerados ---
\renewcommand{\@makechapterhead}[1]{%
  \vspace*{-20pt}%
  {\parindent \z@ \raggedright \normalfont
	\hbox to \textwidth{\hfill\color{SoftGray}\fontsize{80pt}{90pt}\selectfont\bfseries\thechapter}%
	\par\vspace{3pt}%
	\hbox to \textwidth{\hfill\color{MediumGray}\fontsize{10pt}{12pt}\selectfont\MakeUppercase{\chaptername}}%
	\par\vspace{8pt}%
    {\color{InkBlack}\rule{\textwidth}{0.8pt}}%
    \par\vspace{14pt}%
    \begingroup
      \color{InkBlack}\fontsize{24pt}{30pt}\selectfont\bfseries
      \baselineskip=30pt
      \noindent #1\par
    \endgroup
    \nobreak
    \vskip 30\p@
  }%
}

% --- Capítulos sin número (Introducción, Conclusiones, etc.) ---
\renewcommand{\@makeschapterhead}[1]{%
  \markboth{#1}{}%
  \vspace*{40pt}%
  {\parindent \z@ \raggedright \normalfont
    {\color{InkBlack}\rule{\textwidth}{0.8pt}}%
    \par\vspace{14pt}%
    \begingroup
      \color{InkBlack}\fontsize{24pt}{30pt}\selectfont\bfseries
      \baselineskip=30pt
      \noindent #1\par
    \endgroup
    \par\nobreak
    \vskip 30\p@
  }%
}

\makeatother

%% ============================================================
%%  FORMATO DE SECCIONES — numeradas, tipografía sólida
%% ============================================================

\setcounter{secnumdepth}{2}  % capítulos y secciones numerados (1.1, 1.2, ...)

\titleformat{\section}
  [block]
  {\normalfont\color{InkBlack}\fontsize{14pt}{18pt}\selectfont\bfseries}
  {\thesection}{0.7em}{}
\titleformat{\subsection}
  [block]
  {\normalfont\color{DarkGray}\fontsize{12pt}{15pt}\selectfont\bfseries}
  {\thesubsection}{0.6em}{}
\titleformat{\subsubsection}
  [block]
  {\normalfont\color{DarkGray}\fontsize{11pt}{14pt}\selectfont\bfseries\itshape}
  {}{0pt}{}

% Versión sin número (para \section*)
\titleformat{name=\section, numberless}
  [block]
  {\normalfont\color{InkBlack}\fontsize{14pt}{18pt}\selectfont\bfseries}
  {}{0pt}{}

% Espaciado de secciones
\titlespacing*{\section}{0pt}{20pt plus 4pt minus 2pt}{8pt plus 2pt minus 1pt}
\titlespacing*{\subsection}{0pt}{14pt plus 3pt minus 2pt}{6pt plus 2pt minus 1pt}
\titlespacing*{\subsubsection}{0pt}{10pt plus 2pt minus 1pt}{4pt plus 1pt minus 1pt}

%% ============================================================
%%  ENCABEZADO Y PIE DE PÁGINA — minimalista
%% ============================================================

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

\fancyhead[LE]{\footnotesize\color{MediumGray}\textsc{\leftmark}}
\fancyhead[RO]{\footnotesize\color{MediumGray}\textit{\rightmark}}
\fancyfoot[C]{\footnotesize\color{MediumGray}\thepage}

\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
  \fancyfoot[C]{\footnotesize\color{MediumGray}\thepage}%
}

\renewcommand{\chaptermark}[1]{\markboth{\chaptername\ \thechapter\ \textperiodcentered\ #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\ \ #1}{}}

%% ============================================================
%%  HIPERENLACES — coherentes con la paleta monocroma
%% ============================================================

\AtBeginDocument{%
  \ifdefined\hypersetup
    \hypersetup{
      colorlinks  = true,
      linkcolor   = InkBlack,
      citecolor   = DarkGray,
      urlcolor    = DarkGray,
    }
  \fi
}

%% ============================================================
%%  PERSONALIZACIÓN DEL ÍNDICE
%% ============================================================

\usepackage{titletoc}

\titlecontents{chapter}
  [0pt]
  {\addvspace{12pt}\bfseries\color{InkBlack}}
  {\contentslabel{1.8em}}
  {}
  {\hfill\color{InkBlack}\contentspage}

\titlecontents{section}
  [1.8em]
  {\addvspace{2pt}\color{DarkGray}}
  {\contentslabel{2.4em}}
  {}
  {\titlerule*[0.6pc]{\color{SoftGray}.}\contentspage}

\titlecontents{subsection}
  [4.2em]
  {\addvspace{1pt}\small\color{MediumGray}}
  {\contentslabel{3.0em}}
  {}
  {\titlerule*[0.6pc]{\color{SoftGray}.}\contentspage}
